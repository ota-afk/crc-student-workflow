OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=
USE_MOCK=true
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8501
# Shared secret for the X-API-Key header. Empty = check off (local only). Set it when deployed.
API_KEY=
RATE_LIMIT=60/minute
# mock = fixed sample chat. live = the API's POST /assistant at API_URL (needs OPENAI_* on the API).
ASSISTANT_MODE=mock
# Reminder emails (Resend). Empty key = reminders switched off.
RESEND_API_KEY=
# Comma-separated addresses the demo may email. Empty = nobody.
REMINDER_RECIPIENTS=
REMINDER_FROM=Flyover <onboarding@resend.dev>
